{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transit-lab.local/schemas/run-event.v2.json",
  "title": "Transit Lab structured run event v2",
  "type": "object",
  "required": ["schemaVersion", "seq", "runId", "timestamp", "type"],
  "properties": {
    "schemaVersion": {"const": 2},
    "seq": {"type": "integer", "minimum": 0},
    "attemptSeq": {"type": "integer", "minimum": 0},
    "runId": {"type": "string", "minLength": 1},
    "attemptId": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "type": {"type": "string"},
    "phase": {"type": "string"},
    "step": {"type": ["string", "integer"]},
    "epoch": {"type": "integer", "minimum": 0},
    "total": {"type": "integer", "minimum": 0},
    "completed": {"type": "integer", "minimum": 0},
    "unit": {"type": "string"},
    "name": {"type": "string"},
    "value": {"type": "number"},
    "path": {"type": "string"},
    "reason": {"type": "string"},
    "exitCode": {"type": "integer"},
    "code": {"type": "string"},
    "message": {"type": "string"},
    "dimensions": {"type": "object"},
    "artifactId": {"type": "string"},
    "artifactKind": {"type": "string"},
    "uri": {"type": "string"},
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
  },
  "additionalProperties": true
}
