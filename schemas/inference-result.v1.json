{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transit-lab.local/schemas/inference-result.v1.json",
  "title": "Transit Lab inference result v1",
  "type": "object",
  "required": ["schemaVersion", "modelId", "snapshotId", "metricNames", "predictions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "inferenceId": {"type": "string", "minLength": 1},
    "modelId": {"type": "string", "minLength": 1},
    "snapshotId": {"type": "string", "minLength": 1},
    "metricNames": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["line", "metrics", "structuralUniqueness"],
        "properties": {
          "line": {"type": ["string", "number"]},
          "lineName": {"type": "string"},
          "metrics": {"type": "array", "items": {"type": "number"}},
          "metricPercentiles": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}},
          "structuralUniqueness": {"type": "number"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
