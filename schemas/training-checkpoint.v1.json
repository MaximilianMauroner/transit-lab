{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transit-lab.local/schemas/training-checkpoint.v1.json",
  "title": "Transit Lab committed training checkpoint v1",
  "type": "object",
  "required": ["schemaVersion", "runId", "globalStep", "phase", "datasetFingerprint", "configFingerprint", "codeCommit", "backend", "backendVersion", "deviceType", "status", "checkpointFingerprint", "files"],
  "properties": {
    "schemaVersion": {"const": 1},
    "runId": {"type": "string", "minLength": 1},
    "attemptId": {"type": ["string", "null"]},
    "globalStep": {"type": "integer", "minimum": 0},
    "phase": {"type": "string", "minLength": 1},
    "datasetFingerprint": {"type": "string", "minLength": 1},
    "configFingerprint": {"type": "string", "minLength": 1},
    "codeCommit": {"type": "string", "minLength": 1},
    "backend": {"type": "string", "minLength": 1},
    "backendVersion": {"type": "string", "minLength": 1},
    "deviceType": {"type": "string", "minLength": 1},
    "status": {"const": "committed"},
    "checkpointFingerprint": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "sizeBytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$)).+"},
          "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "sizeBytes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
