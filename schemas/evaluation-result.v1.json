{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transit-lab.local/schemas/evaluation-result.v1.json",
  "title": "Transit Lab evaluation result v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "datasetId",
    "datasetFingerprint",
    "split",
    "topK",
    "trainingExamples",
    "fitExamples",
    "metrics"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "datasetId": {"type": "string", "minLength": 1},
    "datasetFingerprint": {"type": "string", "minLength": 1},
    "modelId": {"type": ["string", "null"], "minLength": 1},
    "modelPath": {"type": ["string", "null"]},
    "split": {"enum": ["all", "train", "validation", "test"]},
    "topK": {"type": "integer", "minimum": 1},
    "trainingExamples": {"type": "integer", "minimum": 0},
    "fitExamples": {"type": "integer", "minimum": 0},
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["baseline", "values"],
        "properties": {
          "baseline": {"type": "string", "minLength": 1},
          "values": {
            "type": "object",
            "required": ["examples", "snapshots"],
            "properties": {
              "examples": {"type": "integer", "minimum": 0},
              "snapshots": {"type": "integer", "minimum": 0},
              "spearman": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
              "pairwiseAccuracy": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
              "topKOverlap": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "createdAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
