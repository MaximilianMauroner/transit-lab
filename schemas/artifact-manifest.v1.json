{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transit-lab.local/schemas/artifact-manifest.v1.json",
  "title": "Transit Lab artifact manifest v1",
  "type": "object",
  "required": ["schemaVersion", "artifactId", "kind", "fingerprint", "sha256", "createdAt", "producingRunId", "inputs", "gitCommit", "configuration", "files"],
  "properties": {
    "schemaVersion": {"const": 1},
    "artifactId": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "minLength": 1},
    "fingerprint": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "createdAt": {"type": "string", "format": "date-time"},
    "producingRunId": {"type": ["string", "null"]},
    "inputs": {"type": "array", "items": {"type": "object", "required": ["artifactId", "fingerprint"]}},
    "gitCommit": {"type": "string", "minLength": 1},
    "configuration": {"type": "object"},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$)).+"},
          "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "sizeBytes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": true
      }
    },
    "metadata": {"type": "object"}
  },
  "additionalProperties": true
}
